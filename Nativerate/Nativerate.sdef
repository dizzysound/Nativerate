<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Nativerate Terminology">
    <suite name="LS Suite" code="sdse" description="Standard commands for this application">
        <command name="get latest sample rate" code="getlrate" description="returns the last known sample rate">
            <cocoa class="Nativerate.ScriptableApplicationCommand"/>
            <result type="integer" description="sample rate"/>
        </command>
        <command name="export logs" code="sdseexpl" description="writes the same zip as About Nativerate > Export logs… (engine logs, audio devices, settings, filtered system log) and returns its path; takes up to a few minutes">
            <cocoa class="Nativerate.ExportLogsCommand"/>
            <parameter name="to" code="dest" type="text" optional="yes" description="zip path or folder (default: the Desktop)">
                <cocoa key="destination"/>
            </parameter>
            <result type="text" description="the zip's path, or an error message starting with 'error:'"/>
        </command>
    </suite>
</dictionary>
